{
  "expo": {
    "name": "Suru Nepal - Fashion Store",
    "slug": "suru",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "suru",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "np.com.suru.collection",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Suru Nepal - Fashion Store"
      },
      "icon": "./assets/ios-icon.png",
      "associatedDomains": [
        "webcredentials:suru.com.np"
      ]
    },
    "android": {
      "package": "np.com.suru.collection",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "label": "Suru Nepal - Fashion Store",
      "targetSdkVersion": 36,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "suru",
              "host": "product"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "suru",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "suru.com.np",
              "pathPrefix": "/share/"
            }
          ]
        }
      ]
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffaf6"
    }
  }
}
